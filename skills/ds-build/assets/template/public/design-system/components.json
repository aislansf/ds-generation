      "colors": [
        "default",
        "azul",
        "laranja",
        "verde",
        "escuro"
      ],
      "states": [
        "default",
        "hover",
        "focus",
        "active",
        "disabled"
      ],
      "tokens": [
        "--primary",
        "--primary-foreground",
        "--secondary",
        "--radius-md",
        "--shadow-sm"
      ]
    },
    {
