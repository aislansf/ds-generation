{
  "meta": {
    "name": "__BRAND_NAME__ DS - Components",
    "baseUrl": "https://__DS_DOMAIN__",
    "description": "Manifesto de componentes com variantes, estados e tokens usados."
  },
  "primitives": [
    {
      "id": "button",
      "name": "Button",
      "ref": "/componentes#botao",
