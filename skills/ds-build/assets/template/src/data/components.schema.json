{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://__DS_DOMAIN__/schemas/components.schema.json",
  "title": "__BRAND_SHORT__ DS - Components Manifest",
  "type": "object",
  "required": ["meta", "primitives", "composed"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "baseUrl", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component" }
    },
    "composed": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "component": {
      "type": "object",
      "required": ["id", "name", "ref"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^/" },
        "variants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "colors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tokens": {
          "type": "array",
          "items": { "type": "string", "pattern": "^--[a-z0-9-]+$" }
        },
        "height": { "type": "string" },
        "bannerHeight": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}