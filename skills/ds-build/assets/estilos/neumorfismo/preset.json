      "--shadow-ui": "4px 4px 8px hsl({primaria.h} 12% 10%), -4px -4px 8px hsl({primaria.h} 12% 26%)",
      "--shadow-ui-md": "6px 6px 12px hsl({primaria.h} 12% 10%), -6px -6px 12px hsl({primaria.h} 12% 26%)",
      "--shadow-ui-lg": "8px 8px 16px hsl({primaria.h} 12% 10%), -8px -8px 16px hsl({primaria.h} 12% 26%)",
      "--shadow-ui-xl": "12px 12px 24px hsl({primaria.h} 12% 10%), -12px -12px 24px hsl({primaria.h} 12% 26%)",
      "--shadow-ui-2xl": "16px 16px 32px hsl({primaria.h} 12% 10%), -16px -16px 32px hsl({primaria.h} 12% 26%)",
      "--shadow-ui-inner": "inset 3px 3px 6px hsl({primaria.h} 12% 10%), inset -3px -3px 6px hsl({primaria.h} 12% 26%)",
      "--shadow-inset": "inset 3px 3px 6px hsl({primaria.h} 12% 10%), inset -3px -3px 6px hsl({primaria.h} 12% 26%)",
