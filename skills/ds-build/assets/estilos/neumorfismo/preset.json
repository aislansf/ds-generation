  "grupo": "digitais",
  "nivel": 2,
  "ordem": 14,
  "descricao": "Elementos que saltam do fundo, com luz e sombra suaves na mesma cor. Campos afundados, botões em relevo.",
  "tema_padrao": "light",
  "layout": "padrao",
  "fontes_sugeridas": {
