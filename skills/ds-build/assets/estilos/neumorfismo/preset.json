  "css": "estilo.css",
  "faca": [
    "Mantenha o botão primário com a primária cheia: é o CTA da tela",
    "Dê a todo controle uma borda com 3:1 sobre o fundo"
  ],
  "evite": [
    "Texto tingido com a cor do fundo",
    "Usar só a sombra para indicar estado ou foco"
