{
  "$schema": "../_schema.json",
  "id": "escandinavo",
  "nome": "Escandinavo / Nórdico",
  "grupo": "limpos",
  "nivel": 1,
  "ordem": 5,
  "descricao": "Minimalismo acolhedor: neutros quentes, formas suaves e sombras leves.",
  "tema_padrao": "light",
  "layout": "padrao",
  "fontes_sugeridas": {
    "primaria": [
      "DM Sans",
      "Nunito Sans"
    ]
  },
  "degrade": false,
  "tokens": {
    ":root": {
      "--background": "36 30% 97%",
      "--card": "36 25% 99%",
      "--popover": "36 25% 99%",
      "--muted": "36 18% 93%",
      "--border": "36 14% 86%",
      "--input": "36 10% 55%",
      "--radius": "0.75rem",
      "--radius-card": "1rem",
      "--shadow-ui-sm": "0 1px 3px hsl(30 20% 30% / 0.06)",
      "--shadow-ui": "0 2px 6px hsl(30 20% 30% / 0.06)",
      "--shadow-ui-md": "0 4px 12px hsl(30 20% 30% / 0.06)",
      "--shadow-ui-lg": "0 8px 24px hsl(30 20% 30% / 0.07)",
      "--shadow-ui-xl": "0 16px 40px hsl(30 20% 30% / 0.08)",
      "--shadow-ui-2xl": "0 24px 56px hsl(30 20% 30% / 0.1)",
      "--font-bold": "600",
      "--duration-normal": "250ms",
      "--sidebar-background": "36 25% 95%",
      "--sidebar-foreground": "30 15% 20%",
      "--sidebar-accent": "36 22% 89%",
      "--sidebar-accent-foreground": "30 20% 14%",
      "--sidebar-border": "36 14% 86%",
      "--sidebar-muted": "30 8% 40%",
      "--sidebar-ring": "{primaria}",
      "--header-surface": "36 30% 97%",
      "--header-surface-border": "36 14% 86%"
    },
    ".dark": {
      "--background": "30 10% 9%",
      "--card": "30 10% 12%",
      "--popover": "30 10% 12%",
      "--muted": "30 8% 17%",
      "--border": "30 8% 22%",
      "--input": "30 8% 45%"
    }
  },
  "faca": [
    "Prefira tons quentes e claros nas superfícies",
    "Use cantos suaves e sombras discretas"
  ],
  "evite": [
    "Contrastes duros e preto puro",
    "Cores saturadas em áreas grandes"
  ]
}
